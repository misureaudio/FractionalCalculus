(* Verification: Riemann-Liouville derivative of order alpha = 3/2 of f(x)=Sqrt[x]
   at x = 1/2. Cross-check for differint / pyfod / numfracpy (GL & L2 paths).
   Target: EXACTLY 0  (null-space case: beta+1-alpha = 1/2+1-3/2 = 0).
   Metric: absolute error. Caputo order 3/2 is undefined for Sqrt[x] (f'' not in L^1). *)

alpha = 3/2; beta = 1/2; x0 = 1/2;
f[t_] := Sqrt[t];

Print["=== (1) Closed form  D^alpha RL x^beta = Gamma[beta+1]/Gamma[beta+1-alpha] x^(beta-alpha) ==="];
Print["beta+1-alpha = ", beta + 1 - alpha, "  -> Gamma has a pole there, coefficient = 0"];
Print["Gamma[beta+1]/Gamma[beta+1-alpha] = ", Gamma[beta + 1]/Gamma[beta + 1 - alpha]];
Print["=> analytic D^(3/2) Sqrt[x] = 0  (exact)"];

Print["=== (2) Symbolic R-L  D^(3/2) f(x) = (1/Gamma[1/2]) D[x,x]^2 Integrate[f(t)/Sqrt[x-t],{t,0,x}] ==="];
J[x_] := Integrate[f[t]/Sqrt[x - t], {t, 0, x}, Assumptions -> x > 0];
Print["inner integral J(x) = ", J[x]];
rlSym = (1/Gamma[2 - alpha]) * D[J[x], {x, 2}] /. x -> x0;
Print["J(x) is linear in x -> 2nd derivative = ", D[J[x], {x, 2}]];
Print["RL symbolic value: ", N[rlSym, 20]];

Print["=== (3) Numeric R-L (central 2nd difference of J, independent of symbolic engine) ==="];
numJ[xx_] := NIntegrate[f[t]/Sqrt[xx - t], {t, 0, xx}, WorkingPrecision -> 30];
h = 10^-4;
numRL = (1/Sqrt[Pi]) ((numJ[x0 + h] - 2 numJ[x0] + numJ[x0 - h])/(h^2));
Print["J(x0-h), J(x0), J(x0+h) = ", N[numJ[x0 - h], 10], ", ", N[numJ[x0], 10], ", ", N[numJ[x0 + h], 10]];
Print["RL numeric value: ", N[numRL, 20]];

Print["=== (4) Direct GL sum  (1/h^alpha) Sum_{m>=0} (-1)^m binom(alpha,m) f(x-m h) ==="];
M = 4000;
glsum = (1/h^alpha) Total[Table[(-1)^m Binomial[alpha, m] f[x0 - m h], {m, 0, M}]];
Print["GL sum value: ", N[glsum, 20]];

Print["=== Residuals vs 0 ==="];
Print["|RLsym  - 0|: ", N[Abs[rlSym], 10]];
Print["|RLnum  - 0|: ", N[Abs[numRL], 10]];
Print["|GLsum  - 0|: ", N[Abs[glsum], 10]];
